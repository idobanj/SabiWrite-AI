# =============================================================================
# AI Writing Coach — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values from `supabase start`.
#
#   cp .env.example .env
#
# The `.env` file is gitignored — never commit secrets.
# =============================================================================

# --- Frontend (Vite — these MUST be prefixed VITE_ to be exposed to the browser) ---
# Get these from `supabase status` after running `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-me-with-anon-key-from-supabase-status

# --- Edge Functions (server-only — never prefixed VITE_) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-service-role-key-from-supabase-status

# --- Gemini API key (Phase 2+) ---
# Server-only. Read by the analyze-text Edge Function.
# Get a key at https://aistudio.google.com/apikey (free tier is fine).
GEMINI_API_KEY=