# ============================================================================
# Frontend (Vite) — must be prefixed with VITE_ to be exposed to the browser
# ============================================================================
# After running `supabase start`, copy these values from its output.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# Edge Functions (Supabase) — server-side only, NEVER prefix with VITE_
# ============================================================================
# These are used by `supabase/functions/*` and stay on the server.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# AI Engine — added in Phase 2, leave blank in Phase 0
# ============================================================================
# Get a key from https://aistudio.google.com/apikey
# This key is stored ONLY in Edge Function env vars. It is never sent to
# the browser. The client always calls our Edge Function, not Gemini directly.
GEMINI_API_KEY=
